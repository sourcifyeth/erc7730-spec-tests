      "rawTx": "0x02f84c0180843b9aca00843b9aca00830f424094773000000000000000000000000000000000000180a4a0712d68000000000000000000000000000000000000000000000006b14e9f7e4f5a5000c0",
      "expected": {
        "intent": "Mint",
