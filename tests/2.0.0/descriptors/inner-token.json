{
  "$schema": "../../../schema/spec/erc7730-v2.0.0.schema.json",
  "$comment": "The token that account.json calls. Its formats read @.value and @.from, which the outer calldata field supplies through amountPath and spenderPath.",
  "context": {
    "$id": "Spec Tests: inner token",
    "contract": {
      "deployments": [{ "chainId": 1, "address": "0x7730000000000000000000000000000000000051" }]
    }
  },
  "metadata": { "owner": "Inner Token" },
  "display": {
    "formats": {
      "transfer(address to,uint256 value)": {
        "intent": "Transfer",
        "fields": [
          { "path": "to", "label": "To", "format": "addressName" },
          { "path": "value", "label": "Amount", "format": "tokenAmount", "params": { "tokenPath": "@.to" } },
          { "path": "@.value", "label": "Attached", "format": "amount" },
          { "path": "@.from", "label": "Spender", "format": "raw" }
        ]
      },
      "approve(address spender,uint256 value)": {
        "intent": "Approve",
        "fields": [
          { "path": "spender", "label": "Spender", "format": "raw" },
          { "path": "value", "label": "Amount", "format": "tokenAmount", "params": { "tokenPath": "@.to" } }
        ]
      }
    }
  }
}
